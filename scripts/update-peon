#!/usr/bin/env bash
# update-peon: Update peon-ping to latest upstream version
set -euo pipefail

REPO="https://raw.githubusercontent.com/PeonPing/peon-ping/main"
PEON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/openpeon"
DOTFILES_PEON="$HOME/.local/share/dotfiles/scripts/peon"

echo "=== update-peon ==="

# Step 1: Download upstream peon.sh, insert CLAUDE_PEON_DIR hardcode
echo "-> peon.sh"
curl -fsSL "$REPO/peon.sh" -o /tmp/peon-new.sh
sed -i '/^CLAUDE_PEON_DIR=/d; /^# --- Platform detection ---/a\CLAUDE_PEON_DIR="${CLAUDE_PEON_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/openpeon}"' /tmp/peon-new.sh
cp /tmp/peon-new.sh "$DOTFILES_PEON"
chmod +x "$DOTFILES_PEON"

# Step 2: VERSION
echo "-> VERSION"
curl -fsSL "$REPO/VERSION" -o "$PEON_DIR/VERSION"

# Step 3: Supporting scripts, filter by rule:
#   - extension .sh only (skip .ps1 .swift .js)
#   - skip cmux-* hook-handle-* lint-* (cmux, Claude hooks, dev tools)
echo "-> scripts"
mkdir -p "$PEON_DIR/scripts"
UPSTREAM_SCRIPTS=$(gh api repos/PeonPing/peon-ping/contents/scripts --paginate -q '.[].name' | grep '\.sh$' | grep -vE '^(cmux-|hook-handle-|lint-)')
[ -z "$UPSTREAM_SCRIPTS" ] && { echo "   (no scripts to download)" >&2; } || \
while IFS= read -r s; do
    curl -fsSL "$REPO/scripts/$s" -o "$PEON_DIR/scripts/$s"
    chmod +x "$PEON_DIR/scripts/$s"
    echo "   $s"
done <<< "$UPSTREAM_SCRIPTS"
# relay.sh lives at top level
curl -fsSL "$REPO/relay.sh" -o "$PEON_DIR/relay.sh"
chmod +x "$PEON_DIR/relay.sh"
echo "   relay.sh"

echo "=== done ==="
echo "$DOTFILES_PEON ($(wc -l < "$DOTFILES_PEON") lines)"
echo "$PEON_DIR/config.json"
