# bash login shell 配置（/etc/profile 之后加载）
# 供 bash -lc 场景使用，如 pi-feishu-lark daemon 启动桥接时定位 pi 命令

# 补充用户本地二进制目录到 PATH
case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) PATH="${HOME}/.local/bin:${PATH}" ;;
esac
export PATH

# pi-feishu-lark daemon 通过 PI_BIN 定位 pi 可执行文件（绝对路径，不依赖 PATH）
if [ -x "${HOME}/.local/bin/pi" ]; then
    export PI_BIN="${HOME}/.local/bin/pi"
fi
