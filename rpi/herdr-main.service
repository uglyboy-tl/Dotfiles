[Unit]
Description=Herdr 远程桥接 server（session main）
Documentation=https://herdr.dev/docs/configuration/
After=network-online.target
# 已有 server 在跑时 `herdr server` 会立刻以 1 退出。限流避免 systemd 每 3 秒重试一次。
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# 复刻 herdr bootstrap 拉会话 server 的方式：cmdline 是 `herdr server`，会话由 HERDR_SESSION 指定
# （用 `herdr --session main server` 语法也对，但 bootstrap 用的是环境变量，保持一致）
Environment=HERDR_SESSION=main
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
