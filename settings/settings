#!/usr/bin/env bash
# 设置脚本
# 用法:
#   settings          用 fzf 选择设置项
#   settings --gui    用 rofi 选择设置项

set -euo pipefail

: "${XDG_DATA_HOME:=$HOME/.local/share}"

DOTFILES_DIR="$XDG_DATA_HOME/dotfiles"

# 加载公共函数(含 epipe_init/select_ui/selector_gui_supported/menu_loop)并初始化 stdout 安全
source "$DOTFILES_DIR/settings/lib/selectors.sh"
source "$DOTFILES_DIR/settings/lib/menu.sh"
epipe_init

# 解析 --gui: 确定 UI 模式并导出给子脚本(子脚本不再接收 --gui)
# 若指定 --gui 但环境不支持(缺 rofi 或无图形会话)，则回退 tui
_ui="${SELECTOR_UI:-tui}"
for _arg in "$@"; do
  case "$_arg" in
    --gui)
      if selector_gui_supported; then
        _ui=gui
      else
        echo "提示: 图形界面不可用(缺少 rofi 或无图形会话)，回退到 tui" >&2
        _ui=tui
      fi
      ;;
  esac
done
export SELECTOR_UI="$_ui"

# 设置项列表
get_settings_items() {
  cat <<EOF
主题
壁纸
字体
开关
快捷键
关于
EOF
}

# 处理设置项
handle_settings() {
  case "$1" in
    主题) "$DOTFILES_DIR/settings/setting-theme.sh" ;;
    壁纸) "$DOTFILES_DIR/settings/setting-wallpaper.sh" ;;
    字体) "$DOTFILES_DIR/settings/setting-font.sh" ;;
    开关) "$DOTFILES_DIR/settings/setting-toggles.sh" ;;
    快捷键) "$DOTFILES_DIR/settings/setting-keybindings.sh" ;;
    关于) "$DOTFILES_DIR/settings/setting-about.sh" ;;
  esac
}

main() {
  menu_loop "设置" get_settings_items handle_settings --root
}

main "$@"
