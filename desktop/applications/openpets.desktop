[Desktop Entry]
Type=Application
Name=OpenPets
Comment=OpenPets tray-first desktop companion app.
# Xft.dpi=120 时 OpenPets 用 window.getBounds()(逻辑像素) 算 X11 bounding shape
# 再乘 scaleFactor，结果比实际窗口大约 1.2 倍，裁剪区顶边落在宠物精灵顶部之上，
# 把耳朵齐刷刷水平切掉。强制 scaleFactor=1 可让 shape 计算正确
# （见 dist/pet-window.js applyLinuxPetWindowShape）。代价是 UI 变小，用 petScale 补偿。
Exec=/opt/OpenPets/openpets --force-device-scale-factor=1 %U
Terminal=false
Icon=openpets
StartupWMClass=OpenPets
MimeType=x-scheme-handler/openpets;
Categories=Utility;
