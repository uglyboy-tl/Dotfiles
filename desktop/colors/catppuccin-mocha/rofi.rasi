/*
 * Catppuccin Mocha - Rofi Color Definition
 * Omarchy color variable naming convention (dash-connected)
 */

* {
  /* Background colors */
  background: #1e1e2e;
  dark-background: #181825;
  darker-background: #11111b;
  lighter-background: #313244;

  /* Foreground colors */
  foreground: #cdd6f4;
  dark-foreground: #a6adc8;
  light-foreground: #bac2de;
  bright-foreground: #f5e0dc;

  /* Semantic colors */
  accent: #cba6f7;
  selection: #89b4fa;
  muted: #6c7086;

  /* ANSI colors */
  red: #f38ba8;
  green: #a6e3a1;
  yellow: #f9e2af;
  blue: #89b4fa;
  purple: #cba6f7;
  cyan: #94e2d5;
  orange: #fab387;

  background-color: @background;
}
