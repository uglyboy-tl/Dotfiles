[Unit]
Description=idle-screensaver 抑制服务（提供 org.freedesktop.ScreenSaver）
# 总线名被占用时脚本自行 exit 0 退出，不抢
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/share/dotfiles/desktop/idle-screensaver/idle-screensaver-dbus.py
Restart=on-failure
RestartSec=3
# 只有 SimulateUserActivity 用到 X 且失败静默（X 自带屏保已被 bspwmrc 的 xset s off 关掉），故不传 DISPLAY

[Install]
WantedBy=default.target
