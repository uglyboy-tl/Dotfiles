/*
 * ROFI theme - 月历弹出（由 desktop/polybar/scripts/rofi-calendar.py 调用）
 * 颜色通过 colors.rasi 导入
 */

@import "colors"

configuration {
  show-icons: false;
  hover-select: false; /* 鼠标移动不改变选中 */
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  location: 3;
  font: "Hack Nerd Font Mono 12";
}

entry {
  enabled: false; /* 禁止键盘输入过滤 */
}

window {
  transparency: "real";
  background-color: transparent;
  border-radius: 14px;
  width: 440px;
  x-offset: -14px;
  y-offset: 56px;
}

mainbox {
  background-color: @background;
  border-radius: 14px;
  children: [inputbar, message, listview];
  padding: 14px;
}

inputbar {
  color: @foreground;
  background-color: @lighter-background;
  border-radius: 10px;
  padding: 12px 16px;
  children: [prompt];
}

prompt {
  background-color: inherit;
  text-color: @foreground;
  padding: 0;
}

message {
  background-color: @background;
  text-color: @dark-foreground;
  padding: 14px 2px 10px;
  horizontal-align: 0.5;
}

listview {
  columns: 7;
  lines: 6;
  spacing: 8px;
  padding: 4px;
  background-color: @background;
  dynamic: false;
}

element {
  padding: 11px 0;
  border-radius: 9px;
  background-color: transparent;
  text-color: @foreground;
}

element-text {
  horizontal-align: 0.5;
  background-color: inherit;
  text-color: inherit;
}

/* 导航按钮（脚本用 -a 标记为 active）：浅底 + 主题强调色 */
element active {
  background-color: @lighter-background;
  text-color: @accent;
}

element selected {
  background-color: @accent;
  text-color: @background;
}

/* 按钮被选中时仍用选中配色，避免强调色字压在强调色底上 */
element selected.active {
  background-color: @accent;
  text-color: @background;
}
