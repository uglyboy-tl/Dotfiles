@import "colors"

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

configuration {
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  location:	3;
}

window {
  transparency:		"real";
  background-color:		transparent;
  text-color:			@foreground;
  border-radius:		10px;
  width:			371px;
  x-offset:			-10px;
  y-offset:			48px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  position: center;
  padding: 4px;
  expand: false;
  border: 4px;
  border-color: @lighter-background;
  border-radius: 10px;
  margin: 25px 20px 0 20px;
  color: @foreground;
  background-color: @dark-background;

  children: [textbox-prompt-colon, textbox-spacer-left, prompt, textbox-spacer-right];
}

textbox-spacer-left, textbox-spacer-right {
  expand: true;
}

textbox-prompt-colon {
  expand: false;
  str: "";
  font: "Maple Mono Normal CN 16";
  background-color: inherit;
  text-color: @red;
  margin: 5px 10px 0 10px;
}

prompt {
  location: center;
  expand: false;
  text-font: inherit;
  vertical-align: 0.5;
  text-color: @foreground;
  background-color: inherit;
  padding: 0 4px;
  margin-right: 6px;
}

listview {
  background-color:               transparent;
  margin:                         25px 20px;
  cycle:                          true;
  dynamic:                        true;
  layout:                         horizontal;
}

element {
  padding:	17px 20px 17px 20px;
  border-radius:                  100%;
  border: 1px;
  border-color: @lighter-background;
  background-color:               transparent;
  text-color: @foreground;
  orientation:                    horizontal;
  margin: 0 15px;
}

element-text {
  font: "Hack Nerd Font Mono 22";
  background-color: inherit;
  text-color:       inherit;
  height:	38px;
  width:	38px;
  horizontal-align: 0.5;
}

element selected {
  text-color: @background;
  background-color: @accent;
  border-radius: 100%;
}
