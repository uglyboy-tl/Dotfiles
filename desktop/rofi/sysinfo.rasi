/*
 * ROFI theme - 系统信息面板（由 desktop/scripts/rofi-sysinfo.py 调用）
 * 6 列 2 行：上排信息，下排控制。颜色通过 colors.rasi 导入
 */

@import "colors"

configuration {
  show-icons: false;
  hover-select: false; /* 鼠标移动不改变选中 */
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  location: 3; /* 右上角，与 calendar.rasi 一致 */
  font: "Hack Nerd Font Mono 11";
}

entry {
  enabled: false; /* 只读面板，无输入 */
}

window {
  transparency: "real";
  background-color: transparent;
  location: 3;
  border-radius: 10px;
  width: 830px;
  x-offset: -14px;
  y-offset: 56px;
}

mainbox {
  background-color: @background;
  border-radius: 10px;
  children: [listview];
  padding: 12px;
}

listview {
  columns: 6;
  lines: 2;
  spacing: 8px;
  padding: 0;
  dynamic: false;
  background-color: transparent;
}

/* 药丸格子：比面板底色亮一档 */
element {
  padding: 8px 0;
  border-radius: 9px;
  background-color: @lighter-background;
  text-color: @foreground;
}

element-text {
  horizontal-align: 0.5;
  background-color: inherit;
  text-color: inherit;
}

/* 只读面板：选中态与常态一致，避免固定高亮第一格 */
element selected {
  background-color: @lighter-background;
  text-color: @foreground;
}
