@import "colors"

configuration {
  show-icons:		true;
  display-drun:		"";
  icon-theme:			"Numix";
  /*drun-display-format:	" {name}";*/
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  location:			1;
}

window {
  transparency:		"real";
  background-color:		transparent;
  text-color:			@foreground;
  border-radius:		10px;
  width:			400px;
  x-offset:			10px;
  y-offset:			48px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  color: @foreground;
  background-color: @lighter-background;

  border: 1px;
  border-radius:  10px 10px 0px 0px;
  border-color: @darker-background;

  children: [prompt, entry];
}

entry, prompt, case-indicator {
  text-font: inherit;
  text-color:inherit;
}

entry {
  background-color: inherit;
  padding: 16px 6px;
}

prompt {
  background-color: inherit;
  padding: 16px;
}

listview {
  lines: 8;
  padding: 8px;
}

element {
  padding: 6px;
  border-radius: 10px;
  background-color: transparent;
  text-color: @foreground;
}

element-icon {
  background-color: inherit;
  text-color:       inherit;
  font-size: 24px;
  padding: 10px;
}

element-text {
  background-color: inherit;
  text-color:       inherit;
  padding: 8px 8px;
}

element selected {
  text-color: @background;
  background-color: @accent;
}

element-text, element-icon {
  background-color: inherit;
  text-color:       inherit;
}
