{
  "mcpServers": {
    "minimax": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "minimax-mcp", "-y"],
      "env": {
        "MINIMAX_API_KEY": "!cat ~/.config/local/minimax.key",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "MINIMAX_API_RESOURCE_MODE": "local",
        "MINIMAX_MCP_BASE_PATH": "~/Music/tts"
      },
      "description": "MiniMax 文本转语音",
      "exposure": "hidden",
      "toolExposure": {
        "text_to_audio": "codemode"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "description": "Context7：查最新版本的库/框架官方文档与代码示例",
      "exposure": "codemode"
    }
  }
}
