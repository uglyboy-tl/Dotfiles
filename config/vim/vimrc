" ──────────────────────────────────────────────
" XDG 路径设置
" ──────────────────────────────────────────────
set runtimepath^=$XDG_CONFIG_HOME/vim
set runtimepath+=$XDG_DATA_HOME/vim
set runtimepath+=$XDG_CONFIG_HOME/vim/after
set packpath^=$XDG_DATA_HOME/vim,$XDG_CONFIG_HOME/vim
set packpath+=$XDG_CONFIG_HOME/vim/after,$XDG_DATA_HOME/vim/after

" ──────────────────────────────────────────────
" 目录初始化
" ──────────────────────────────────────────────
let g:netrw_home = $XDG_DATA_HOME."/vim"
call mkdir($XDG_DATA_HOME."/vim/spell", 'p')
set backupdir=$XDG_STATE_HOME/vim/backup | call mkdir(&backupdir, 'p')
set directory=$XDG_STATE_HOME/vim/swap   | call mkdir(&directory, 'p')
set undodir=$XDG_STATE_HOME/vim/undo     | call mkdir(&undodir, 'p')
set viewdir=$XDG_STATE_HOME/vim/view     | call mkdir(&viewdir, 'p')
if !has('nvim') | set viminfofile=$XDG_STATE_HOME/vim/viminfo | endif

" ──────────────────────────────────────────────
" 本地配置加载
" ──────────────────────────────────────────────
let $LOCALFILE=expand("~/.config/local/vimrc")
if filereadable($LOCALFILE)
  source $LOCALFILE
endif

" ──────────────────────────────────────────────
" 插件管理 (vim-plug)
" ──────────────────────────────────────────────
if filereadable(expand('~/.config/vim/plug.vim'))
  source ~/.config/vim/plug.vim
endif

call plug#begin('~/.config/vim/plugged')

if filereadable(expand("~/.config/vim/vimrc.plug"))
  source ~/.config/vim/vimrc.plug
endif

call plug#end()

" ──────────────────────────────────────────────
" 外观设置
" ──────────────────────────────────────────────
colorscheme nord
let g:nord_cursor_line_number_background = 1
let g:nord_italic_comments = 1
let g:lightline = {'colorscheme': '16color'}
set noshowmode

" ──────────────────────────────────────────────
" 编辑器设置
" ──────────────────────────────────────────────
set mouse=a
if has("mouse_sgr")
    set ttymouse=sgr
else
    set ttymouse=xterm2
endif

" ──────────────────────────────────────────────
" 快捷键
" ──────────────────────────────────────────────
let mapleader = ','
map <space> /
map ; :Files<CR>
nmap <leader>w :w!<cr>
nnoremap <silent> <leader>f :Rg<CR>
command! W execute 'w !sudo tee "%:p" > /dev/null' | edit!
