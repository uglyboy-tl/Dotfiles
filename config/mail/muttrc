# =============================================================================
# NeoMutt 配置 - 配色跟随终端 16 色
# 分类: 基础功能 → UI → 颜色 → 快捷键 → 插件
# =============================================================================

# =============================================================================
# 1. 基础功能设置
# =============================================================================
set charset = "utf-8"
set timeout = 3
set mail_check = 60
set mail_check_stats = yes
set resolve = yes
set quit = yes
set delete = yes
set move = no
set mbox_type = "Maildir"
set folder = "$XDG_DATA_HOME/Mail"

# 编辑器
set editor = "vim"
set edit_headers = yes
set fast_reply = yes
set include = yes
set forward_quote = yes
set attribution = "On %d, %n wrote:"

# MIME 处理
auto_view text/html text/calendar
alternative_order text/plain text/html text/enriched
set mailcap_path = ~/.config/mutt/mailcap
set implicit_autoview = yes

# 账户设置
set realname = "田陆"
set from = "uglyboy@aliyun.com"
set use_from = yes
set envelope_from = yes

# 邮箱配置
source ~/.config/mutt/mailboxes
# =============================================================================
# 2. UI 界面设置
# =============================================================================
# 基础 UI
unset help
unset wait_key
unset confirmappend
unset mark_old
set auto_tag = yes
set menu_scroll = yes
set reverse_alias = yes

# 侧边栏
set sidebar_visible = yes
set sidebar_width = 26
set sidebar_short_path = yes
set sidebar_next_new_wrap = yes
set sidebar_divider_char = "│"
set sidebar_format = "%D%*  %?N?%N&?"

# 索引显示
set date_format = "%m/%d %H:%M"
# %Z = 邮件状态标识 (新/旧/回复/重要等)
# %L = 邮件列表标识 (由 subscribe 定义)
set index_format = "%4C %Z %{%m/%d} %-15.15F %s"
set sort = reverse-last-date
set use_threads = threads
set sort_aux = last-date-received
set strict_threads = no

# 状态栏
set to_chars=""
set status_chars = " "
ifdef crypt_chars set crypt_chars = " "
set flag_chars = "      "

# 分页器
set pager_index_lines = 10
set pager_context = 5
set pager_stop = yes
set smart_wrap = yes
set tilde = yes
unset markers
set display_filter="sed -e '/\\[-- 类型: text.* --\\]/d' | sed -e '/\\[-- .*自动显示.* --\\]/d' | sed -e '/\\[-- 类型.* --\\]/d' |  sed -e '/\\[-- .*unsupported.* --\\]/d' | sed -e '/\\[-- 附件 #[0-9] --\\]/d' | sed -e 's/附件 #[0-9]: //g' | sed '/./,/^$/!d'"

# 邮件头部
set header = yes
set weed = yes
unhdr_order *
hdr_order from: to: cc: date: subject: reply-to:

# =============================================================================
# 3. 颜色主题 (使用终端 16 色索引, 跟随终端主题)
#
# 槽位选择依据：拿 themes/colors/ 里 8 个主题实测对比度（WCAG 正文线 4.5:1）。
# ANSI 8 在各主题上是 1.57（oxocarbon）到 4.69（vesper）的暗灰，当正文色用不达标，
# 所以 index_number / signature / tilde 从 color8 换成 color6/color4。
# ANSI 1（红）在 nord 3.05、kanagawa 3.22，只当强调不当文字。
# =============================================================================
color normal          default default
color error           color1  default
color message         color4  default
# indicator: color0 压 color6，实测 5.03-11.41；原 color0/color4 在 nord 只有 3.74
color indicator       color0  color6
color tree            color15 default
# status: color7 压 color0，实测 5.15-14.81；原 color15/color8 在 gruvbox 只有 2.23
color status          color7  color0
color index           color15 default
color index_number    color6  default
color index_author    color13 default
color index_subject   color15 default
color index_date      color3  default
color index_flags     color1  default
color index           color1  default "~D"
color index           color3  default "~T"
color hdrdefault      color15 default
color header          color4  default "^From:"
color header          color4  default "^To:"
color header          color3  default "^Subject:"
color header          color3  default "^Date:"
color quoted0         color2  default
color quoted1         color6  default
color signature       color4  default
# search: 原 `default color3` 是终端默认前景（浅）压黄底，实测 1.05-1.78，完全看不清
color search          color0  color3
color tilde           color4  default
color attachment      color5  default
color sidebar_flagged color1  default
color sidebar_new     color10 default
color sidebar_indicator color0 color6

# =============================================================================
# 4. 快捷键
# =============================================================================
bind index G last-entry
bind index g noop
bind index gg first-entry

# 侧边栏控制 (Ctrl+方向键)
macro index,pager <left> "<sidebar-prev><sidebar-open>" "上一个邮箱并打开"
macro index,pager <right> "<sidebar-next><sidebar-open>" "下一个邮箱并打开"
bind index,pager \Cb sidebar-toggle-visible

# 搜索
macro index,pager / "<limit>" "搜索邮件..."
# =============================================================================
# 5. 插件/扩展配置
# =============================================================================
# Notmuch 配置
set nm_default_uri = "notmuch:///home/uglyboy/.local/share/Mail"
set virtual_spoolfile = yes
set nm_query_type = "messages"
set nm_unread_tag = "unread"
set nm_replied_tag = "replied"